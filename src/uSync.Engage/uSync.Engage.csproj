<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>

		<ContentTargetFolders>content</ContentTargetFolders>

		<Product>uSync.Engage</Product>
		<PackageId>uSync.Engage</PackageId>

		<Title>uSync Engage</Title>
		<Description>uSync for Umbraco Engage settings - personas, customer journeys, goals, segments and more</Description>
		<PackageTags>umbraco usync engage umbraco-marketplace</PackageTags>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<PackageReadmeFile>readme.md</PackageReadmeFile>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />

		<PackageReference Include="Umbraco.Cms.Web.Website" Version="17.3.0" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="17.3.0" />
		<PackageReference Include="Umbraco.Engage" Version="17.5.0">
			<ExcludeAssets>buildTransitive;build</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="uSync.BackOffice" Version="17.3.5" />
	</ItemGroup>
</Project>
